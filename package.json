{
  "name": "sidedoor-api",
  "version": "1.0.0",
  "description": "SSH/SFTP Certificate Management Service",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "bun run src/index.ts",
    "start": "bun run src/index.ts",
    "pm2:start": "pm2 start ecosystem.config.json",
    "pm2:stop": "pm2 stop ecosystem.config.json",
    "pm2:restart": "pm2 restart ecosystem.config.json",
    "pm2:logs": "pm2 logs sidedoor-api",
    "pm2:status": "pm2 status",
    "pm2:delete": "pm2 delete sidedoor-api",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "build": "bun build src/index.ts --outdir ./dist --target bun --minify",
    "ci": "bun run typecheck && bun run lint && bun run format:check",
    "docker:build": "docker-compose build",
    "docker:build:dev": "docker-compose -f docker-compose.dev.yml build",
    "docker:up": "docker-compose up -d --remove-orphans",
    "docker:up:dev": "docker-compose -f docker-compose.dev.yml up -d --remove-orphans",
    "docker:down": "docker-compose down --remove-orphans -v",
    "docker:down:dev": "docker-compose -f docker-compose.dev.yml down --remove-orphans -v",
    "docker:logs": "docker-compose logs -f --tail=100",
    "docker:logs:dev": "docker-compose -f docker-compose.dev.yml logs -f --tail=100",
    "docker:restart": "docker-compose restart",
    "docker:restart:dev": "docker-compose -f docker-compose.dev.yml restart",
    "docker:exec": "docker exec -it sidedoor-api bash",
    "docker:exec:dev": "docker exec -it sidedoor-api-dev bash",
    "docker:ps": "docker ps --filter name=sidedoor",
    "docker:clean": "docker-compose down --remove-orphans -v",
    "droplet:remove-host": "bash scripts/remove-droplet-host.sh",
    "droplet:test-ssh": "bash scripts/test-ssh-migration.sh"
  },
  "keywords": [
    "ssh",
    "sftp",
    "certificate",
    "chroot",
    "api",
    "sidedoor"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "elysia": "^1.4.22",
    "nanoid": "^5.1.6",
    "pm2": "^6.0.14",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.7",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3"
  }
}
